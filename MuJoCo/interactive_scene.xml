      <geom name="d_mousepad" pos="0.14 -0.10 0.401" size="0.06 0.07 0.002" type="box" material="mat_pc_black"/>
      <geom name="d_coffee_mug" pos="0.25 -0.05 0.43" size="0.028 0.035" type="cylinder" material="mat_coffee_mug"/>
    </body>

