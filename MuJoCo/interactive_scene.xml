<mujoco model="bruce it office scene">
  <include file="bruce.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <option timestep="0.001" gravity="0 0 -9.81" tolerance="1e-05" cone="elliptic" jacobian="dense" solver="Newton" noslip_iterations="10" integrator="Euler" iterations="30" impratio="10.0">
    <flag override="enable" gravity="enable" contact="enable"/>
  </option>

  <default>
    <joint limited="true" damping="2.0" armature="0.05" frictionloss="0.1"/>
    <geom condim="4" friction="1.5 0.01 0.0002" solref="0.004 1" solimp="0.9 0.95 0.001"/>
  </default>

  <visual>
    <headlight diffuse="0.30 0.30 0.30" ambient="0.15 0.15 0.15" specular="0.0 0.0 0.0"/>
    <rgba haze="0.12 0.15 0.20 1"/>
    <global azimuth="140" elevation="-25"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <!-- Soft Sky Atmosphere -->
    <texture type="skybox" builtin="gradient" rgb1="0.25 0.38 0.55" rgb2="0.06 0.08 0.12" width="512" height="3072"/>
    
    <!-- Floor Texture: Soft Grey Matte Office Floor (Reduced glare) -->
    <texture type="2d" name="tex_floor" builtin="checker" mark="edge" rgb1="0.52 0.55 0.58" rgb2="0.44 0.46 0.49" markrgb="0.36 0.38 0.40" width="512" height="512"/>
    <material name="mat_floor" texture="tex_floor" texuniform="true" texrepeat="12 12" specular="0.10" shininess="0.1" reflectance="0.0"/>

    <!-- Furniture Materials -->
    <material name="mat_table_wood" specular="0.2" shininess="0.2" rgba="0.60 0.40 0.24 1"/>
    <material name="mat_table_metal" specular="0.5" shininess="0.5" rgba="0.22 0.23 0.25 1"/>
    <material name="mat_chair_seat" specular="0.2" shininess="0.2" rgba="0.20 0.38 0.62 1"/>
    <material name="mat_chair_frame" specular="0.6" shininess="0.5" rgba="0.75 0.77 0.80 1"/>
    <material name="mat_wall" specular="0.08" shininess="0.08" rgba="0.75 0.77 0.80 1"/>
    <material name="mat_wall_base" specular="0.2" shininess="0.2" rgba="0.28 0.30 0.32 1"/>

    <!-- IT Equipment & Office Materials -->
    <material name="mat_pc_black" specular="0.3" shininess="0.4" rgba="0.12 0.12 0.14 1"/>
    <material name="mat_pc_screen" specular="0.8" shininess="0.8" rgba="0.16 0.35 0.58 1"/>
    <material name="mat_server_rack" specular="0.4" shininess="0.4" rgba="0.14 0.15 0.17 1"/>
    <material name="mat_server_slot" specular="0.2" shininess="0.2" rgba="0.22 0.24 0.28 1"/>
    <material name="mat_led_green" specular="0.9" shininess="0.9" rgba="0.15 0.90 0.35 1"/>
    <material name="mat_led_amber" specular="0.9" shininess="0.9" rgba="0.95 0.65 0.10 1"/>
    <material name="mat_whiteboard" specular="0.5" shininess="0.5" rgba="0.95 0.96 0.98 1"/>
    <material name="mat_sticky_yellow" specular="0.1" shininess="0.1" rgba="0.95 0.85 0.20 1"/>
    <material name="mat_sticky_cyan" specular="0.1" shininess="0.1" rgba="0.20 0.75 0.88 1"/>
    <material name="mat_cooler_white" specular="0.3" shininess="0.3" rgba="0.92 0.93 0.95 1"/>
    <material name="mat_water_jug" specular="0.8" shininess="0.8" rgba="0.20 0.55 0.85 0.75"/>
    <material name="mat_tap_blue" specular="0.3" shininess="0.3" rgba="0.15 0.45 0.85 1"/>
    <material name="mat_tap_red" specular="0.3" shininess="0.3" rgba="0.85 0.20 0.15 1"/>
    <material name="mat_coffee_mug" specular="0.5" shininess="0.5" rgba="0.92 0.92 0.95 1"/>

    <!-- Dynamic Props Materials -->
    <material name="mat_cardboard" specular="0.1" shininess="0.1" rgba="0.75 0.58 0.38 1"/>
    <material name="mat_parcel_tape" specular="0.3" shininess="0.3" rgba="0.82 0.68 0.44 1"/>
    <material name="mat_soccer_ball" specular="0.6" shininess="0.5" rgba="0.95 0.95 0.95 1"/>
    <material name="mat_blue_box" specular="0.3" shininess="0.3" rgba="0.18 0.50 0.85 1"/>

    <!-- Legacy Compatibility Material Names -->
    <material name="wood_mat" specular="0.3" shininess="0.3" rgba="0.60 0.40 0.24 1"/>
    <material name="metal_mat" specular="0.7" shininess="0.6" rgba="0.22 0.23 0.25 1"/>
    <material name="barrel_mat" specular="0.5" shininess="0.4" rgba="0.14 0.15 0.17 1"/>
    <material name="ball_mat" specular="0.6" shininess="0.5" rgba="0.95 0.95 0.95 1"/>
    <material name="box_mat" specular="0.1" shininess="0.1" rgba="0.75 0.58 0.38 1"/>
    <material name="target_mat" specular="0.1" shininess="0.1" rgba="0.75 0.58 0.38 1"/>
    <material name="obstacle_mat" specular="0.3" shininess="0.3" rgba="0.20 0.38 0.62 1"/>
    <material name="wall_mat" specular="0.1" shininess="0.1" rgba="0.75 0.77 0.80 1"/>
    <material name="wall_accent" specular="0.3" shininess="0.3" rgba="0.20 0.38 0.62 1"/>
    <material name="goal_net_mat" specular="0.1" shininess="0.1" rgba="0.95 0.95 0.95 0.4"/>
  </asset>

  <worldbody>
    <!-- Soft Studio Lighting (Comfortable brightness, no harsh glare) -->
    <light pos="2.0 -3.0 6.0" dir="-0.3 0.4 -1.0" directional="true" diffuse="0.55 0.55 0.53" specular="0.12 0.12 0.12" castshadow="true"/>
    <light pos="-3.0 3.0 5.0" dir="0.4 -0.3 -0.8" directional="true" diffuse="0.22 0.23 0.25" specular="0.05 0.05 0.05" castshadow="false"/>

    <!-- Cameras -->
    <camera name="overview_cam" pos="3.0 -3.0 2.2" xyaxes="0.707 0.707 0 -0.35 0.35 0.87"/>
    <camera name="front_cam" pos="2.4 0 0.8" xyaxes="0 1 0 -0.2 0 0.98"/>
    <camera name="side_cam" pos="0 -2.8 0.9" xyaxes="1 0 0 0 0.25 0.97"/>
    <camera name="follow_cam" mode="trackcom" pos="1.8 -1.4 1.0" xyaxes="0.75 0.66 0 -0.25 0.28 0.92"/>

    <!-- Arena Floor (14m x 14m) -->
    <geom name="floor" size="14 14 0.05" type="plane" material="mat_floor" condim="4"/>

    <!-- Clean Perimeter Walls (North, South, East, West) -->
    <geom name="wall_north" pos="0  7.0 0.35" size="7.0 0.08 0.35" type="box" material="mat_wall"/>
    <geom name="wall_south" pos="0 -7.0 0.35" size="7.0 0.08 0.35" type="box" material="mat_wall"/>
    <geom name="wall_east"  pos=" 7.0 0 0.35" size="0.08 7.0 0.35" type="box" material="mat_wall"/>
    <geom name="wall_west"  pos="-7.0 0 0.35" size="0.08 7.0 0.35" type="box" material="mat_wall"/>

    <!-- ======================================================= -->
    <!-- REALISTIC IT OFFICE FURNITURE & FIXTURES                -->
    <!-- Scaled proportionally to BRUCE (0.45m humanoid)         -->
